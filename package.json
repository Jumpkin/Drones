{
  "name": "drones-acoustic-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "simulate": "tsx scripts/headless-sim.ts",
    "simulate:quick": "tsx scripts/headless-sim.ts --trials 5 --localization-trials 40"
  },
  "dependencies": {
    "fft.js": "^4.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
