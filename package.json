{
  "name": "drones-acoustic-simulator",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "lint": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx server/migrate.ts",
    "db:reset": "tsx server/reset.ts --confirm-disposable-drones-data",
    "start": "node dist/server/index.js",
    "train:model": "tsx scripts/train-model.ts",
    "data:fsd50k": "tsx scripts/ingest-fsd50k.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "simulate": "tsx scripts/headless-sim.ts",
    "simulate:quick": "tsx scripts/headless-sim.ts --trials 3 --localization-trials 40 --phone-trials 1",
    "simulate:yamnet-local": "tsx scripts/yamnet-local-benchmark.ts",
    "stats:update": "tsx scripts/update-benchmark-stats.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1",
    "fft.js": "^4.0.4",
    "onnxruntime-web": "^1.29.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "protobufjs": "^7.6.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
