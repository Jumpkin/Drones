{
  "name": "drones-acoustic-simulator",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "train:model": "tsx scripts/train-model.ts",
    "data:fsd50k": "tsx scripts/ingest-fsd50k.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "simulate": "tsx scripts/headless-sim.ts",
    "simulate:quick": "tsx scripts/headless-sim.ts --trials 3 --localization-trials 40 --phone-trials 1",
    "simulate:yamnet-local": "tsx scripts/yamnet-local-benchmark.ts",
    "stats:update": "tsx scripts/update-benchmark-stats.ts"
  },
  "dependencies": {
    "fft.js": "^4.0.4",
    "onnxruntime-web": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "protobufjs": "^7.6.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
